LIVE_VLM_ENDPOINT=http://127.0.0.1:8000/v1
LIVE_VLM_KEY=
# 实际视觉模型；Agent未配置独立视觉模型时由宿主选择注入
LIVE_VLM_MODEL=
# 未配置时新知识保持待验证；最小值2，按业务证据要求设置
IAD_KNOWLEDGE_MIN_SUPPORT_SOURCES=
# 可选：自定义原生工作台端口（默认 5173）
# PORT=5173

# 仅已有vLLM后端配置此预检协议；留空表示容量未知，不尝试生成
LIVE_VLM_CAPACITY_MODE=vllm_tokenize
# 可选的已确认视觉输入上限，含全图/ROI/Mask/比较图；留空不预设数量上限
IAD_VLM_MAX_VISUAL_INPUTS=
# 服务声明更小图数限制、请求体上限、上下文上限时显式配置
LIVE_VLM_MAX_IMAGES=
LIVE_VLM_MAX_REQUEST_BYTES=
LIVE_VLM_CONTEXT_TOKENS=
# 服务声明单次输出上限时填写；留空使用容量预检得到的剩余上下文
LIVE_VLM_MAX_OUTPUT_TOKENS=
# 请求/连接超时秒数；留空为不设该期限
LIVE_VLM_TIMEOUT_SECONDS=
LIVE_VLM_CONNECT_TIMEOUT_SECONDS=
# 当前服务支持的可选协议参数，例如禁用推理须按实际后端配置
LIVE_VLM_REQUEST_PARAMETERS={}
