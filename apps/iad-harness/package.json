{
  "name": "@industrial-benchmark/iad-harness",
  "version": "0.5.0",
  "description": "Industrial Benchmark Agent DeepSeek Harness Bundle and Extension",
  "type": "module",
  "main": "lib/server/index.js",
  "types": "lib/server/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/server/index.d.ts",
      "default": "./lib/server/index.js"
    },
    "./core-client": {
      "types": "./lib/server/core-client/index.d.ts",
      "default": "./lib/server/core-client/index.js"
    },
    "./policy": {
      "types": "./lib/server/policy/index.d.ts",
      "default": "./lib/server/policy/index.js"
    },
    "./audit": {
      "types": "./lib/server/audit/index.d.ts",
      "default": "./lib/server/audit/index.js"
    },
    "./vision": {
      "types": "./lib/server/vision/index.d.ts",
      "default": "./lib/server/vision/index.js"
    },
    "./benchmark": {
      "types": "./lib/server/benchmark/index.d.ts",
      "default": "./lib/server/benchmark/index.js"
    },
    "./evaluation": {
      "types": "./lib/server/evaluation/index.d.ts",
      "default": "./lib/server/evaluation/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "scripts": {
    "generate:contracts": "node scripts/generate-contracts.js",
    "typecheck": "node scripts/generate-contracts.js --check && tsc --noEmit",
    "build": "node scripts/generate-contracts.js && tsc && node scripts/build-client.js",
    "test": "node --test test/*.test.js",
    "test:browser": "node --test browser/*.test.js",
    "verify:host-browser": "node scripts/verify-host-browser.js"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh": "0.2.0-rc.2",
    "@deepseek-ai/dsh-api-session-controller": "0.2.0-rc.2",
    "@deepseek-ai/dsh-attachment": "0.2.0-rc.2",
    "@deepseek-ai/dsh-base": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-conversation": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-tool": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-workspace": "0.2.0-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.0-rc.2",
    "@deepseek-ai/dsh-mcp-client": "0.2.0-rc.2",
    "@deepseek-ai/dsh-session": "0.2.0-rc.2",
    "@deepseek-ai/dsh-skill": "0.2.0-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.0-rc.2",
    "@deepseek-ai/dsh-typert-protocol": "0.2.0-rc.2",
    "@deepseek-ai/dsh-web-app": "0.2.0-rc.2",
    "@floating-ui/react-dom": "2.1.9",
    "uuid": "13.0.0"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-agent": "0.2.0-rc.2",
    "@deepseek-ai/dsh-agent-loop": "0.2.0-rc.2",
    "@deepseek-ai/dsh-attachment-local": "0.2.0-rc.2",
    "@deepseek-ai/dsh-fs-local": "0.2.0-rc.2",
    "@deepseek-ai/dsh-llm-pi-ai": "0.2.0-rc.2",
    "@deepseek-ai/dsh-session-projection": "0.2.0-rc.2",
    "@deepseek-ai/dsh-system-prompt": "0.2.0-rc.2",
    "@deepseek-ai/dsh-tool-skill": "0.2.0-rc.2",
    "@types/react": "^18.3.1",
    "axe-core": "4.14.0",
    "esbuild": "^0.28.2",
    "json-schema-to-typescript": "^16.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "selenium-webdriver": "^4.51.0",
    "wcag-contrast": "3.0.0"
  }
}
